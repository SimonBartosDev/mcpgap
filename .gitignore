dist/
build/

# Scanner working directories. These hold unpacked untrusted package code and
# must never reach the repository.
workdir/
runs/
*.sbom.json

# The top-level fixtures/ directory is the malware corpus. It is committed ONLY
# as password-protected archives; an unpacked tree there is live malware and is
# never tracked. Anchored with a leading slash so it cannot match the benign
# synthetic servers under tests/fixtures/.
/fixtures/**/unpacked/
/fixtures/**/*.js
!/fixtures/**/PROVENANCE.md
